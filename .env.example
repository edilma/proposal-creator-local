# Copy to .env and fill in the key. .env is gitignored — never commit it.
# Every value here may also be exported as an environment variable instead;
# exported variables win over .env entries.

# Model provider label. Use "stub" for a free offline dry-run that stores
# UNKNOWN for every requirement without calling any API.
PROPOSAL_MODEL_PROVIDER=

# OpenAI-compatible API base URL (no trailing /chat/completions).
PROPOSAL_MODEL_BASE_URL=

# Bearer API key. Never print it, log it, or commit it.
PROPOSAL_MODEL_API_KEY=

# Model name, e.g. a reasoning model that supports JSON output.
PROPOSAL_MODEL_NAME=

# Provider-specific reasoning knob; blank omits it from the request.
PROPOSAL_MODEL_REASONING_EFFORT=

# Token budget. Reasoning models spend it on thinking first — be generous.
PROPOSAL_MODEL_MAX_TOKENS=

# Sampling temperature (0 = most deterministic).
PROPOSAL_MODEL_TEMPERATURE=

# HTTP timeout in seconds for one model call.
PROPOSAL_MODEL_TIMEOUT=

# Company profile the model judges against (Markdown).
PROPOSAL_COMPANY_PROFILE=

# SQLite database file.
PROPOSAL_DB=
